{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-brain.local/schemas/admission.schema.json",
  "title": "Knowledge-Brain admission list",
  "type": "object",
  "required": ["schema_version", "directories"],
  "properties": {
    "schema_version": {
      "const": "v1.0"
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "enabled"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$"
          },
          "enabled": {
            "type": "boolean"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
